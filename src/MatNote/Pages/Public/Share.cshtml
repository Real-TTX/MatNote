@page "/s/{token}/{noteId:long?}"
@model MatNote.Pages.Public.ShareModel
@using MatNote.Services.Export
@{
    Layout = "_LayoutPublic";
    var note = Model.Note;
}

@{ var explorer = Model.Share.FolderId is not null && Model.Tree is not null; ViewData["Wide"] = explorer; }

@if (explorer)
{
    @:<div class="mn-explorer">
        <nav class="mn-explorer__tree" aria-label="Folders of this link">
            <ul class="mn-tree__list mn-tree__list--root"><partial name="_PublicTree" model="(Model.Tree!, Model.Folder, Model.BaseUrl)" /></ul>
        </nav>
    @:<div class="mn-explorer__main">
}

@if (Model.Share.FolderId is not null && Model.Path.Count > 0)
{
    <nav class="mat-crumbs mn-address" aria-label="Folders">
        @Ui.Icon("folder")
        <ol>
            @for (var i = 0; i < Model.Path.Count; i++)
            {
                var p = Model.Path[i];
                if (i == Model.Path.Count - 1 && note is null)
                {
                    <li aria-current="page">@p.Name</li>
                }
                else
                {
                    <li><a href="@Model.BaseUrl?folder=@p.Id">@p.Name</a></li>
                }
            }
        </ol>
    </nav>
}

@if (note is not null)
{
    <div class="mat-card">
        <div class="mat-card__body">
            @if (Model.BodyHtml is not null)
            {
                <div class="mn-doc" id="note-body">@Html.Raw(Model.BodyHtml)</div>
                if (note.Type != NoteType.RichText)
                {
                    <textarea id="note-raw" hidden readonly>@note.Content</textarea>
                }
            }
            else if (note.Type == NoteType.Pdf)
            {
                <iframe class="mn-pdf" src="@Model.BaseUrl/file/@note.Id?inline=true" title="@note.Title"></iframe>
            }
            else if (Model.FileHtml is not null)
            {
                <div class="mn-doc mn-preview">@Html.Raw(Model.FileHtml)</div>
            }
            else
            {
                <div class="mat-empty">
                    <span class="mat-empty__icon">@Ui.Icon("paperclip")</span>
                    <div class="mat-empty__title">@note.FileName</div>
                    <p>@(Model.Share.AllowExport ? "There is no preview for this kind of file. Download it to open it." : "There is no preview for this kind of file.")</p>
                </div>
            }
            <partial name="_Attachments" model="new MatNote.Pages.Shared.AttachmentsModel(note.Id, Model.Attachments, false, Model.Token, Model.Share.AllowExport)" />
        </div>
    </div>

    <div class="mat-btn-row">
        @if (Ui.IsText(note.Type))
        {
            if (note.Type == NoteType.RichText)
            {
                <button type="button" class="mat-btn mat-btn--secondary" data-copy-inner="#note-body">@Ui.Icon("copy")<span>Copy</span></button>
            }
            else
            {
                <button type="button" class="mat-btn mat-btn--secondary" data-copy="#note-raw">@Ui.Icon("copy")<span>Copy</span></button>
            }
        }

        @if (Model.Share.AllowExport)
        {
            if (!Ui.IsText(note.Type))
            {
                <a class="mat-btn mat-btn--secondary" href="@Model.BaseUrl/file/@note.Id">@Ui.Icon("download")<span>Download</span></a>
            }

            <button type="button" class="mat-btn mat-btn--secondary" data-dialog-open="export-dialog" aria-haspopup="dialog">@Ui.Icon("upload")<span>Export</span></button>
        }

        @if (Model.Share.FolderId is not null)
        {
            <a class="mat-btn mat-btn--secondary" href="@Model.BaseUrl?folder=@Model.Folder">@Ui.Icon("back")<span>Back to the folder</span></a>
        }
    </div>

    @if (Model.Share.AllowExport && Model.Formats.Count > 0)
    {
        <dialog class="mat-dialog mat-dialog--sm" id="export-dialog" aria-labelledby="export-title">
            <form class="mat-dialog__form" method="get" action="@Model.BaseUrl/export/@note.Id">
                <div class="mat-dialog__head">
                    @Ui.Icon("upload")
                    <h2 class="mat-dialog__title" id="export-title">Export this note</h2>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@Ui.Icon("x")</button>
                </div>
                <div class="mat-dialog__body mat-form">
                    <fieldset class="mat-field mat-fieldset">
                        <legend class="mat-label">Format</legend>
                        <div class="mat-options">
                            @{ var defaultFormat = Math.Max(0, Model.Formats.ToList().IndexOf(ExportFormat.Markdown)); }
                    @for (var i = 0; i < Model.Formats.Count; i++)
                            {
                                var format = Model.Formats[i];
                                <label class="mat-option"><input type="radio" name="format" value="@format" checked="@(i == defaultFormat)" /><span>@MatNote.Pages.Notes.ViewModel.FormatName(format)</span></label>
                            }
                        </div>
                    </fieldset>
                    @if (Model.Attachments.Count > 0)
                    {
                        <div class="mat-field">
                            <label class="mat-check"><input type="checkbox" name="attachments" value="true" checked /><span class="mat-check__text"><strong>Include the attachments</strong><small class="mat-muted">@Model.Attachments.Count attached file@(Model.Attachments.Count == 1 ? "" : "s"): the export becomes a zip with the file and a directory <em>attachments</em>.</small></span></label>
                        </div>
                    }
                    @if (Ui.IsText(note.Type))
                    {
                        <div class="mat-field">
                            <label class="mat-check"><input type="checkbox" name="linked" value="true" checked /><span class="mat-check__text"><strong>Copy linked notes into the export</strong><small class="mat-muted">Only notes that are part of this share.</small></span></label>
                        </div>
                    }
                </div>
                <div class="mat-dialog__foot">
                    <div class="mat-btn-row mat-btn-row--plain">
                        <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("download")<span>Export</span></button>
                        <button type="button" class="mat-btn mat-btn--secondary" data-export-copy data-tip="Copy the export as text instead of downloading it">@Ui.Icon("copy")<span>Copy to clipboard</span></button>
                        <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                    </div>
                </div>
            </form>
        </dialog>
    }
}
else
{
    @if (Model.Subfolders.Count == 0 && Model.Notes.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon">@Ui.Icon("folder")</span>
            <div class="mat-empty__title">This folder is empty</div>
        </div>
    }
    else
    {
        @* like a file explorer: the folders first, then the notes *@
        <div class="mn-files" role="list" aria-label="Content of this folder">
            <div class="mn-files__head" aria-hidden="true"><span></span><span>Name</span><span>Type</span><span>Changed</span></div>
            @foreach (var sub in Model.Subfolders)
            {
                <a class="mn-files__row mn-files__row--folder" role="listitem" href="@Model.BaseUrl?folder=@sub.Id">
                    @Ui.Icon("folder")
                    <span class="mn-files__name"><strong>@sub.Name</strong><small>@sub.Notes @(sub.Notes == 1 ? "note" : "notes")@(sub.Folders > 0 ? $" · {sub.Folders} {(sub.Folders == 1 ? "folder" : "folders")}" : "")</small></span>
                    <span class="mn-files__type">Folder</span>
                    <span class="mn-files__date"></span>
                </a>
            }
            @foreach (var n in Model.Notes)
            {
                <a class="mn-files__row" role="listitem" href="@Model.BaseUrl/@n.Id">
                    @Ui.Icon(Ui.TypeIcon(n.Type))
                    <span class="mn-files__name"><strong>@n.Title</strong><small class="mn-files__small">@Ui.TypeName(n.Type) · @n.Updated.ToString("yyyy-MM-dd")</small></span>
                    <span class="mn-files__type">@Ui.TypeName(n.Type)</span>
                    <span class="mn-files__date">@n.Updated.ToString("yyyy-MM-dd")</span>
                </a>
            }
        </div>
    }
}

@if (explorer)
{
    @:</div></div>
}
